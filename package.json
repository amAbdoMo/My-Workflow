{
  "name": "wizard-schedule-snippets",
  "version": "0.1.0",
  "private": true,
  "productName": "Wizard Schedule & Snippets",
  "description": "Desktop schedule tracker and WordPress snippet library.",
  "homepage": ".",
  "main": "electron.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "imapflow": "^1.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "express": "^4.21.2"
  },
  "scripts": {
    "start": "node server/index.js",
    "electron": "electron .",
    "dev:electron": "cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "desktop": "npm run build:desktop && electron .",
    "package:portable": "npm run build:desktop",
    "install:shortcut": "powershell -ExecutionPolicy Bypass -File .\\create-desktop-shortcut.ps1",
    "build": "react-scripts build",
    "build:renderer": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-app.ps1",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\build-portable.ps1",
    "import:snippets": "node scripts/import-snippets.js && node scripts/format-snippets.js",
    "format:snippets": "node scripts/format-snippets.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server:dev": "node server/index.js",
    "build:desktop": "npm run build:renderer && npm run build:portable"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^41.0.0",
    "rcedit": "^5.0.2"
  }
}
